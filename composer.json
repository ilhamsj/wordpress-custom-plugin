{
  "name": "ilhamsj/wordpress-custom-plugin",
  "type": "wordpress-plugin",
  "description": "Wordpress Plugin Inspiried from movie",
  "authors": [
    {
      "name": "ilhamsj",
      "email": "ilhamsaputrajati@outlook.com"
    }
  ],
  "license": "MIT",
  "minimum-stability": "dev",
  "require": {
    "composer/installers": "~1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "helpers/config.php"
    ]
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/techinasia/WordPress-Coding-Standards.git"
    }
  ],
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "master",
    "wp-coding-standards/wpcs": "dev-develop"
  }
}
